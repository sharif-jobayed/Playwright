{
	"compilerOptions": {
		"target": "ES2020",
		"module": "commonjs",
		"lib": [
			"ES2020",
			"DOM"
		],
		"strict": true,
		"esModuleInterop": true,
		"moduleResolution": "node",
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"types": [
			"node",
			"jest",
			"playwright"
		]
	},
	"include": [
		"src",
		"tests",
		"playwright.config.ts"
	],
	"scripts": {
		"test": "npx playwright test",
		"test:headed": "npx playwright test --headed",
		"test:debug": "PWDEBUG=1 npx playwright test --debug"
	}
}
